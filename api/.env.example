# Copy to .env for local development. Never commit real values.
PORT=3001
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Direct delivery to Telegram (preferred). Set both in the Render dashboard.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional fallback used only while TELEGRAM_* are empty: an existing server-side
# relay that already holds the Telegram credentials (the portfolio API).
CONTACT_RELAY_URL=

# Optional tuning
UPSTREAM_TIMEOUT_MS=60000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
